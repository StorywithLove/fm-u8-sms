# The U8 is normally available at this address over USB RNDIS or Wi-Fi.
FM_U8_BASE_URL=http://192.168.0.1
FM_U8_USERNAME=admin
FM_U8_PASSWORD=replace-with-your-device-password

# Match the official dashboard's 15-second refresh interval by default.
FM_U8_POLL_INTERVAL_MS=15000
FM_U8_RECONCILE_INTERVAL_MS=600000
FM_U8_TIMEOUT_MS=10000

# The state file stores message fingerprints only, not SMS bodies.
FM_U8_STATE_FILE=./data/state.json

# Local inbox web app. The server only accepts connections from this computer.
FM_U8_WEB_HOST=127.0.0.1
FM_U8_WEB_PORT=8788
FM_U8_INBOX_FILE=./data/inbox.json

# Optional: append newly detected messages as JSON Lines. This file contains
# SMS bodies and may contain verification codes, so protect it accordingly.
# FM_U8_OUTPUT_FILE=./data/inbox.jsonl
